<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cineplanet.ProductoController">

    <VBox spacing="15"
          AnchorPane.topAnchor="20"
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20">

        <Label text="CINEPLANET"
               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

        <Label text="GESTIÓN DE PRODUCTOS"
               style="-fx-font-size: 18px;"/>

        <HBox spacing="10">

            <VBox spacing="5">
                <Label text="ID"/>
                <TextField fx:id="txtId"
                           promptText="ID"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Nombre"/>
                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Categoría"/>
                <TextField fx:id="txtCategoria"
                           promptText="Categoría"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Precio"/>
                <TextField fx:id="txtPrecio"
                           promptText="Precio"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Stock"/>
                <TextField fx:id="txtStock"
                           promptText="Stock"/>
            </VBox>

        </HBox>

        <HBox spacing="10">

            <Button fx:id="btnRegistrar"
                    text="Registrar"
                    onAction="#registrar"/>

            <Button fx:id="btnActualizar"
                    text="Actualizar"
                    onAction="#actualizar"/>

            <Button fx:id="btnEliminar"
                    text="Eliminar"
                    onAction="#eliminar"/>

            <Button fx:id="btnLimpiar"
                    text="Limpiar"
                    onAction="#limpiar"/>

        </HBox>

        <TableView fx:id="tablaProductos"
                   VBox.vgrow="ALWAYS"
                   onMouseClicked="#seleccionarProducto">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"/>

                <TableColumn fx:id="colNombre"
                             text="Nombre"/>

                <TableColumn fx:id="colCategoria"
                             text="Categoría"/>

                <TableColumn fx:id="colPrecio"
                             text="Precio"/>

                <TableColumn fx:id="colStock"
                             text="Stock"/>

            </columns>

        </TableView>

    </VBox>

</AnchorPane>