<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.RowConstraints?>

<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="miContenedor"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cineplanet.ProductoController">


    <children>

        <VBox spacing="10.0"
              AnchorPane.topAnchor="5.0"
              AnchorPane.bottomAnchor="5.0"
              AnchorPane.leftAnchor="5.0"
              AnchorPane.rightAnchor="5.0">

            <children>

                <!-- ENCABEZADO -->

                <AnchorPane prefHeight="80.0">

                    <children>

                        <Label layoutX="14.0"
                               layoutY="10.0"
                               text="Gestionar Productos"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                        <Label layoutX="14.0"
                               layoutY="42.0"
                               text="CINEPLANET"
                               style="-fx-font-size: 15px;"/>

                        <Label layoutX="500.0"
                               layoutY="10.0"
                               text="Filtrar Productos"/>

                        <TextField fx:id="txtFiltro"
                                   layoutX="500.0"
                                   layoutY="35.0"
                                   prefWidth="180.0"
                                   promptText="Buscar producto"/>

                        <Button layoutX="690.0"
                                layoutY="35.0"
                                prefWidth="80.0"
                                prefHeight="30.0"
                                mnemonicParsing="false"
                                text="🔍 Buscar"/>

                    </children>

                </AnchorPane>


                <!-- CONTENIDO PRINCIPAL -->

                <HBox spacing="15.0"
                      VBox.vgrow="ALWAYS">

                    <children>


                        <!-- FORMULARIO -->

                        <AnchorPane prefWidth="430.0"
                                    minWidth="400.0">

                            <children>

                                <GridPane layoutX="5.0"
                                          layoutY="5.0"
                                          hgap="10.0"
                                          vgap="10.0">

                                    <columnConstraints>

                                        <ColumnConstraints minWidth="120.0"
                                                           prefWidth="130.0"/>

                                        <ColumnConstraints minWidth="200.0"
                                                           prefWidth="250.0"/>

                                    </columnConstraints>


                                    <rowConstraints>

                                        <RowConstraints minHeight="40.0"/>
                                        <RowConstraints minHeight="40.0"/>
                                        <RowConstraints minHeight="40.0"/>
                                        <RowConstraints minHeight="40.0"/>
                                        <RowConstraints minHeight="40.0"/>
                                        <RowConstraints minHeight="15.0"/>
                                        <RowConstraints minHeight="48.0"/>
                                        <RowConstraints minHeight="48.0"/>
                                        <RowConstraints minHeight="48.0"/>
                                        <RowConstraints minHeight="48.0"/>
                                        <RowConstraints minHeight="45.0"/>

                                    </rowConstraints>


                                    <children>


                                        <!-- TITULO -->

                                        <Label text="Formulario de Registro"
                                               GridPane.columnSpan="2"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


                                        <!-- ID -->

                                        <Label text="ID"
                                               GridPane.rowIndex="1"/>

                                        <TextField fx:id="txtId"
                                                   promptText="Ingrese ID"
                                                   prefHeight="35.0"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>


                                        <!-- NOMBRE -->

                                        <Label text="Nombre Producto"
                                               GridPane.rowIndex="2"/>

                                        <TextField fx:id="txtNombre"
                                                   promptText="Ingrese nombre del producto"
                                                   prefHeight="35.0"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="2"/>


                                        <!-- CATEGORIA -->

                                        <Label text="Categoría"
                                               GridPane.rowIndex="3"/>

                                        <TextField fx:id="txtCategoria"
                                                   promptText="Ingrese categoría"
                                                   prefHeight="35.0"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="3"/>


                                        <!-- PRECIO -->

                                        <Label text="Precio"
                                               GridPane.rowIndex="4"/>

                                        <TextField fx:id="txtPrecio"
                                                   promptText="Ingrese precio"
                                                   prefHeight="35.0"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="4"/>


                                        <!-- STOCK -->

                                        <Label text="Stock"
                                               GridPane.rowIndex="5"/>

                                        <TextField fx:id="txtStock"
                                                   promptText="Ingrese stock"
                                                   prefHeight="35.0"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="5"/>


                                        <!-- REGISTRAR -->

                                        <Button fx:id="btnRegistrar"
                                                mnemonicParsing="false"
                                                text="✓  REGISTRAR"
                                                prefWidth="180.0"
                                                prefHeight="40.0"
                                                onAction="#registrar"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="6"/>


                                        <!-- ACTUALIZAR -->

                                        <Button fx:id="btnActualizar"
                                                mnemonicParsing="false"
                                                text="✎  ACTUALIZAR"
                                                prefWidth="180.0"
                                                prefHeight="40.0"
                                                onAction="#actualizar"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="7"/>


                                        <!-- ELIMINAR -->

                                        <Button fx:id="btnEliminar"
                                                mnemonicParsing="false"
                                                text="✕  ELIMINAR"
                                                prefWidth="180.0"
                                                prefHeight="40.0"
                                                onAction="#eliminar"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="8"/>


                                        <!-- LIMPIAR -->

                                        <Button fx:id="btnLimpiar"
                                                mnemonicParsing="false"
                                                text="↻  LIMPIAR"
                                                prefWidth="180.0"
                                                prefHeight="40.0"
                                                onAction="#limpiar"
                                                GridPane.columnIndex="1"
                                                GridPane.rowIndex="9"/>


                                        <!-- MENSAJE -->

                                        <Label fx:id="lbnMsg"
                                               text=""
                                               wrapText="true"
                                               prefWidth="390.0"
                                               style="-fx-font-size: 14px; -fx-font-weight: bold;"
                                               GridPane.columnSpan="2"
                                               GridPane.rowIndex="10"/>


                                    </children>


                                    <padding>

                                        <Insets top="10.0"
                                                left="10.0"
                                                right="10.0"
                                                bottom="10.0"/>

                                    </padding>

                                </GridPane>

                            </children>

                        </AnchorPane>


                        <!-- TABLA -->

                        <AnchorPane HBox.hgrow="ALWAYS">

                            <children>

                                <TableView fx:id="tablaProductos"
                                           AnchorPane.topAnchor="5.0"
                                           AnchorPane.bottomAnchor="5.0"
                                           AnchorPane.leftAnchor="5.0"
                                           AnchorPane.rightAnchor="5.0"
                                           onMouseClicked="#seleccionarProducto">

                                    <columns>

                                        <TableColumn fx:id="colId"
                                                     text="ID"
                                                     prefWidth="60.0"/>

                                        <TableColumn fx:id="colNombre"
                                                     text="Nombre"
                                                     prefWidth="180.0"/>

                                        <TableColumn fx:id="colCategoria"
                                                     text="Categoría"
                                                     prefWidth="130.0"/>

                                        <TableColumn fx:id="colPrecio"
                                                     text="Precio"
                                                     prefWidth="90.0"/>

                                        <TableColumn fx:id="colStock"
                                                     text="Stock"
                                                     prefWidth="80.0"/>

                                    </columns>

                                </TableView>

                            </children>

                        </AnchorPane>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>


</AnchorPane>


